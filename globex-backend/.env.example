# ─────────────────────────────────────────────
# GlobeX AI — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=globex_dev
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# ── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT (generate with: openssl rand -base64 64) ──
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_BASE64_STRING_AT_LEAST_64_CHARS
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# ── CORS ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── App URLs ──────────────────────────────────
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173

# ── Email (dev: console logging — no SMTP needed) ──
MAIL_PROVIDER=console
# For production, set to smtp and fill in:
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.xxxxxxxxxx
# MAIL_FROM=noreply@globexai.com

# ── Actuator ──────────────────────────────────
ACTUATOR_BASE_PATH=/actuator
