# =============================================================================
# GlobeX AI — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=globex_dev
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_256_bit_random_secret_in_production
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@globex.ai

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Spring Profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# =============================================================================
# PHASE 4 — External Integration API Keys
# =============================================================================

# ── Weather — Open-Meteo ──────────────────────────────────────────────────────
# NO API KEY REQUIRED for non-commercial/portfolio use.
# Provider is configured automatically. No action needed.
# Attribution: "Weather data by Open-Meteo.com" must be shown in UI.

# ── Currency — Frankfurter (European Central Bank) ────────────────────────────
# NO API KEY REQUIRED. Free, open-source, ECB data.
# Attribution: "Rates by Frankfurter / ECB. Updated daily." must be shown.

# ── Places — Overpass API (OpenStreetMap) ─────────────────────────────────────
# NO API KEY REQUIRED. ODbL licensed data.
# Attribution: "© OpenStreetMap contributors" must be shown.

# ── Images — Unsplash ─────────────────────────────────────────────────────────
# REQUIRED for real photos. Get a free key at: https://unsplash.com/oauth/applications
# Without this key, IMAGE_PROVIDER=mock is used (placeholder images, clearly labeled).
# Attribution: Photographer name + Unsplash link is MANDATORY when using Unsplash API.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Set to "unsplash" once you have the key above. Default is "mock" (dev placeholder).
IMAGE_PROVIDER=mock
# IMAGE_PROVIDER=unsplash
